{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "QALenz Configuration",
	"type": "object",
	"required": [
		"schemaVersion",
		"projectRoot",
		"xcodeBuildMCPProfile",
		"scenariosDirectory",
		"targetDefaults",
		"maximumTargetCount"
	],
	"properties": {
		"schemaVersion": {
			"type": "integer",
			"const": 1
		},
		"projectRoot": {
			"type": "string"
		},
		"xcodeBuildMCPProfile": {
			"type": "string"
		},
		"scenariosDirectory": {
			"type": "string"
		},
		"outputDirectory": {
			"type": "string"
		},
		"targetDefaults": {
			"type": "object",
			"required": ["devices", "operatingSystems"],
			"properties": {
				"devices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
				"operatingSystems": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
			},
			"additionalProperties": false
		},
		"maximumTargetCount": {
			"type": "integer",
			"minimum": 1
		}
	}
}
