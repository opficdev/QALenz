#!/bin/sh

tool="$2"

case "$tool" in
	"success")
		printf '%s\n' '{"schema":"xcodebuildmcp.output.fixture","schemaVersion":"1","didError":false,"error":null,"data":{}}'
		;;
	"events")
		printf '%s\n' '{"event":"fixture.invocation","operation":"FIXTURE"}'
		printf '%s\n' '{"event":"fixture.progress","operation":"FIXTURE","message":"Working"}'
		printf '%s\n' '{"event":"fixture.summary","operation":"FIXTURE","status":"SUCCEEDED"}'
		;;
	"streaming")
		signal_path="$3"
		printf '%s\n' '{"event":"fixture.invocation","operation":"FIXTURE"}'
		while [ ! -f "$signal_path" ]; do sleep 0.01; done
		printf '%s\n' '{"event":"fixture.summary","operation":"FIXTURE","status":"SUCCEEDED"}'
		;;
	"failure")
		printf '%s\n' 'secret-token-value' >&2
		exit 9
		;;
	"working-directory")
		pwd
		;;
	"sleep")
		trap 'exit 0' TERM
		while :; do :; done
		;;
	"ignore-term")
		trap '' TERM
		while :; do :; done
		;;
	"child-tree")
		pid_path="$3"
		trap '' TERM
		/bin/sh -c 'trap "" TERM; while :; do :; done' &
		child_pid=$!
		printf '%s\n' "$child_pid" > "$pid_path"
		wait "$child_pid"
		;;
	"launch-marker")
		marker_path="$3"
		: > "$marker_path"
		trap 'exit 0' TERM
		while :; do :; done
		;;
	*)
		exit 64
		;;
esac
